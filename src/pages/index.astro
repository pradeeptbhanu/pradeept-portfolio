---
import MainLayout from '../layouts/MainLayout.astro';
import { projects } from '../data/projects';

const skills = ['Laravel', 'PHP', 'WordPress', 'WooCommerce', 'MySQL', 'JavaScript', 'jQuery', 'REST APIs', 'Shopify', 'Flutter', 'Git', 'AI-assisted development'];
const featuredProjects = projects.filter((project) => project.category.includes('featured'));
const experience = [
  { title: 'Development Team Lead', company: 'AuroInfo LLC | Bhubaneswar, Odisha, India', period: 'Sep 2024 – Present', text: 'Leading development delivery, architecture decisions, code reviews, database optimization, client communication and junior developer coordination.' },
  { title: 'Senior Web Developer', company: 'AlumNetworks Private Limited | India', period: 'Apr 2023 – Sep 2024', text: 'Spearheaded backend architecture and core business logic in Laravel while managing database architecture and frontend integration for alumni engagement systems.' },
  { title: 'Senior Web Developer', company: 'AuroInfo LLC | Bhubaneswar, Odisha, India', period: 'Apr 2019 – Mar 2023', text: 'Delivered multiple WordPress, WooCommerce, Shopify, and Laravel projects for clients across Australia, India, and the USA.' },
  { title: 'Web Developer', company: 'ArcWeb SMAC Pvt. Ltd. | Bhubaneswar, Odisha, India', period: 'Nov 2015 – Mar 2019', text: 'Developed and maintained multiple client websites using WordPress, PHP, CodeIgniter, and JavaScript.' },
  { title: 'Web Developer Trainee', company: 'Pabitra InfoTech Pvt. Ltd. | Bhubaneswar, Odisha, India', period: 'Nov 2014 – Nov 2015', text: 'Delivered Hotel and Hospital Management Systems and ARMS (Real-Estate Management System) in PHP and CodeIgniter.' },
  { title: 'Trainee & Lab Assistant', company: 'National Institute of Information Technology | Bhubaneswar, India', period: 'Jun 2011 – Nov 2014', text: 'Built a practical foundation in software development, programming and technical support while progressing into professional web development.' }
];
---
<MainLayout title="Pradeept Bhanu Sabat | Laravel & WordPress Developer" description="Pradeept Bhanu Sabat — Laravel & WordPress Developer with 10+ years of professional experience building, fixing, and maintaining production web applications and business websites." image="/sudoku-brain-saga/banner.png">
  <section class="hero" id="home">
    <div class="container hero-grid">
      <div class="hero-content reveal visible">
        <div class="eyebrow">Available for Freelance & Contract Projects</div>
        <h1><span class="gradient-text">Laravel & WordPress Developer</span></h1>
        <p class="lead">I build, fix and maintain business websites and web applications using Laravel, PHP, WordPress and MySQL. 10+ years of professional development experience · Production applications · Business websites · E-commerce</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#contact">Discuss Your Project <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href="#projects">View Featured Work</a>
        </div>
        <p id="availability-note">🟢 Currently accepting freelance & contract projects · Bhubaneswar, India · Available worldwide · Remote</p>
        <ul class="socials" aria-label="Contact links">
          <li><a href="mailto:pradeeptbhanu@gmail.com">📧 pradeeptbhanu@gmail.com</a></li>
          <li><a href="tel:+917790022707">📞 +91-7790022707</a></li>
          <li><a href="https://linkedin.com/in/pradeeptbhanu" target="_blank" rel="noopener noreferrer">🔗 LinkedIn</a></li>
          <li><a href="https://pradeeptbhanu.com" target="_blank" rel="noopener noreferrer">🌐 pradeeptbhanu.com</a></li>
        </ul>
      </div>
      <div class="hero-visual reveal visible" aria-hidden="true">
        <div class="portrait-wrap"><div class="portrait"><div class="avatar-text"><strong>PB</strong><span>Team Lead & Sr. Web Dev</span></div></div></div>
        <div class="floating-badge badge-laravel">⚡ Laravel</div><div class="floating-badge badge-wordpress">🌐 WordPress</div><div class="floating-badge badge-php">🐘 PHP</div><div class="floating-badge badge-mysql">🐬 MySQL</div><div class="floating-badge badge-woocommerce">🛒 WooCommerce</div>
      </div>
    </div>
  </section>

  <section class="trust-strip-section" aria-label="Key Trust & Experience Metrics"><div class="container"><div class="trust-strip reveal visible">
    <div class="trust-item"><div class="trust-icon-wrap">◷</div><div class="trust-content"><span class="trust-number">10+ Years Experience</span><span class="trust-sub"><strong class="trust-tag">Laravel & PHP</strong></span></div></div>
    <div class="trust-divider" aria-hidden="true"></div><div class="trust-item"><div class="trust-icon-wrap">⌁</div><div class="trust-content"><span class="trust-number">20+ Production Projects</span><span class="trust-sub"><strong class="trust-tag">WordPress</strong></span></div></div>
    <div class="trust-divider" aria-hidden="true"></div><div class="trust-item"><div class="trust-icon-wrap">▣</div><div class="trust-content"><span class="trust-number">Production Systems</span><span class="trust-sub"><strong class="trust-tag">E-commerce</strong></span></div></div>
  </div></div></section>

  <section id="about"><div class="container">
    <h2 class="section-title reveal">About Me</h2>
    <p class="section-copy reveal">I’m a senior web developer with 10+ years of experience building, fixing, and maintaining production websites and web applications. My core expertise is Laravel, PHP, WordPress, and MySQL, with a strong focus on practical business solutions and reliable backend systems.</p>
    <div class="about-grid">
      <div class="panel about-photo reveal"><div class="photo-card"><div><strong>10+ Years</strong><p>Building and supporting production web applications, e-commerce storefronts, custom Laravel systems, and multi-site WordPress platforms for clients across Australia, USA, and India.</p></div></div></div>
      <div class="panel about-content reveal"><div class="kicker">Experience & Engineering</div><h3>Experienced in building, fixing, and improving real-world web systems</h3><p class="section-copy" style="margin:.8rem 0 0">I’m comfortable working on both new projects and existing codebases—whether you need a feature built, a difficult bug diagnosed, a database optimized, or ongoing technical support.</p><ul class="about-points">
        <li><strong>Production Development</strong>Hands-on experience delivering and supporting business websites, custom web applications, e-commerce systems, and internal platforms.</li>
        <li><strong>Backend Architecture & Query Optimization</strong>Strong experience with PHP, Laravel, MySQL schema design, indexing, API-driven systems, and performance troubleshooting.</li>
        <li><strong>Existing Systems & Support</strong>Comfortable taking over existing applications, understanding unfamiliar codebases, fixing production issues, and delivering new features safely.</li>
      </ul></div>
    </div>
  </div></section>

  <section id="services"><div class="container"><div class="kicker reveal">Client Solutions & Services</div><h2 class="section-title reveal">What You Can Hire Me To Do</h2><p class="section-copy reveal">Specialized technical services for businesses and agencies looking for reliable development, performance optimization, custom features and ongoing maintenance.</p>
    <div class="services-grid">
      <article class="panel service-card reveal"><div class="service-header"><div class="service-icon">▱</div><h3>Laravel & PHP Development</h3></div><p class="service-desc">Custom web applications, admin panels, business logic, APIs and backend systems.</p><ul class="service-work-tags"><li>Laravel applications</li><li>Custom PHP</li><li>REST APIs</li><li>Admin dashboards</li><li>Authentication</li><li>Database-driven systems</li><li>New features</li><li>Existing application maintenance</li></ul></article>
      <article class="panel service-card reveal"><div class="service-header"><div class="service-icon">◎</div><h3>WordPress Development</h3></div><p class="service-desc">Custom WordPress development for businesses that need more than a basic theme installation.</p><ul class="service-work-tags"><li>Custom functionality</li><li>Theme customization</li><li>PHP development</li><li>Plugin integration</li><li>WooCommerce</li><li>API integrations</li><li>Bug fixing</li><li>Performance improvements</li></ul></article>
      <article class="panel service-card reveal"><div class="service-header"><div class="service-icon">⚒</div><h3>Bug Fixing & Maintenance</h3></div><p class="service-desc">Diagnose broken, slow or difficult-to-maintain websites and applications and implement practical fixes.</p><ul class="service-work-tags"><li>Bug diagnosis</li><li>Performance fixes</li><li>Database optimization</li><li>Legacy maintenance</li><li>Security updates</li><li>Ongoing support</li></ul></article>
    </div>
    <div class="services-grid" style="margin-top:1.5rem"><article class="panel service-card reveal"><div class="service-header"><div class="service-icon">&lt;/&gt;</div><h3>API & Third-Party Integrations</h3></div><p class="service-desc">Connect websites and applications with external services and build reliable data flows between systems.</p><ul class="service-work-tags"><li>REST API integrations</li><li>Payment & external services</li><li>Webhooks & callbacks</li><li>Data synchronization</li><li>Custom API endpoints</li><li>Third-party platforms</li></ul></article>
      <article class="panel service-card reveal"><div class="service-header"><div class="service-icon">🛒</div><h3>E-Commerce Development</h3></div><p class="service-desc">Build and improve online stores with WooCommerce or Shopify, from custom features to storefront refinements.</p><ul class="service-work-tags"><li>WooCommerce customization</li><li>Shopify & Liquid</li><li>Product templates</li><li>Custom checkout features</li><li>Third-party apps</li><li>Store performance</li></ul></article>
    </div>
  </div></section>

  <section id="skills"><div class="container"><div class="kicker reveal">Technical Skills</div><h2 class="section-title reveal">Tools I Work With</h2><div class="skills-grid reveal">{skills.map(skill => <span class="skill-chip">{skill}</span>)}</div></div></section>

  <section id="experience"><div class="container"><div class="kicker reveal">Professional Experience</div><h2 class="section-title reveal">10+ years of practical engineering experience</h2><p class="section-copy reveal">Backed by hands-on delivery across technology agencies, business platforms, websites, e-commerce systems and production applications.</p><div class="timeline reveal" aria-label="Career history">
    {experience.map(role => <article class="timeline-item"><h3>{role.title}</h3><div class="company-meta"><span>{role.company}</span><span class="time-badge">{role.period}</span></div><p>{role.text}</p></article>)}
  </div></div></section>

  <section id="projects"><div class="container"><div class="kicker reveal">Selected Work</div><h2 class="section-title reveal">Projects & Case Studies</h2><p class="section-copy reveal">The complete portfolio includes 23 projects spanning Laravel, WordPress, e-commerce, custom business systems and the current independent mobile product.</p>
    <div class="project-controls reveal"><div class="search-filter-wrap"><div class="project-search-box"><span class="search-icon">🔍</span><input type="text" id="projectSearch" placeholder="Search projects by title, tech stack, or keywords..." aria-label="Search projects"></div><div class="project-counter" id="projectCounter">Showing 6 of 23 projects</div></div><ul class="filter-tabs" aria-label="Project filter categories"><li><button class="filter-btn active" data-category="featured">Featured Projects</button></li><li><button class="filter-btn" data-category="laravel">Laravel & PHP</button></li><li><button class="filter-btn" data-category="wordpress">WordPress & CMS</button></li><li><button class="filter-btn" data-category="ecommerce">E-Commerce</button></li><li><button class="filter-btn" data-category="custom">Custom Systems</button></li><li><button class="filter-btn" data-category="all">All Projects (23)</button></li></ul></div>
    <div class="projects-container" id="projectsContainer">
      {projects.map(project => <article class="project-card panel reveal" data-category={project.category}><div><h3>{project.title}</h3><p class="project-meta"><strong>Role:</strong> {project.role}<br><strong>Tech Stack:</strong> {project.tech}</p><p class="project-description">{project.description}</p></div></article>)}
    </div>
  </div></section>

  <section id="education"><div class="container edu-lang-grid"><div class="panel edu-card reveal"><div class="kicker">Qualifications</div><h2 class="section-title" style="font-size:1.8rem">Education & Certifications</h2><div class="edu-item"><h4>GNIIT — Software Engineering</h4><p>National Institute of Information Technology (NIIT) | 2011 – 2014</p></div><div class="edu-item"><h4>Bachelor of Commerce (B.Com)</h4><p>Berhampur University | 2006 – 2009</p></div></div><div class="panel lang-card reveal"><div class="kicker">Communication</div><h2 class="section-title" style="font-size:1.8rem">Languages</h2><p class="section-copy" style="margin-bottom:1rem">Fluent in professional spoken and written communication:</p><ul class="lang-tags"><li>English (Professional)</li><li>Odia (Native)</li><li>Hindi (Fluent)</li></ul></div></div></section>

  <section id="contact"><div class="container contact-grid"><div class="contact-copy reveal"><div class="kicker">Let's Work Together</div><h2 class="section-title">Have a website or application that needs help?</h2><p class="section-copy">Whether you’re starting something new, fixing an existing system, or looking for ongoing technical support, tell me what you need.</p><div class="contact-details"><p>📧 <a href="mailto:pradeeptbhanu@gmail.com">pradeeptbhanu@gmail.com</a></p><p>📞 <a href="tel:+917790022707">+91-7790022707</a></p><p>🔗 <a href="https://linkedin.com/in/pradeeptbhanu" target="_blank" rel="noopener noreferrer">LinkedIn</a></p></div></div><div class="panel contact-form reveal"><div class="kicker">Start a Conversation</div><form id="form" action="https://api.web3forms.com/submit" method="POST"><input type="hidden" name="access_key" value="c86995bc-e573-4000-aaed-0af36d2db97c"><input type="hidden" name="subject" value="New Project Inquiry from Pradeept Portfolio"><input type="hidden" name="from_name" value="Pradeept Bhanu Portfolio Inquiry"><input type="hidden" name="botcheck" value=""><label>Name<input type="text" name="name" placeholder="Your name" required></label><label>Email<input type="email" name="email" placeholder="your.email@example.com" required></label><label>Project Type<select name="project_type" class="form-select" required><option value="" disabled selected>Select project category...</option><option>Laravel & PHP Development</option><option>WordPress Development</option><option>Bug Fixing & Maintenance</option><option>Database & Query Optimization</option><option>API & Third-Party Integrations</option><option>E-Commerce Development</option><option>Other Custom Web Application</option></select></label><label>Message<textarea name="message" rows="6" placeholder="Tell me briefly about your project..." required></textarea></label><button class="btn btn-primary" type="submit">Send Inquiry</button><div id="form-status" role="status" aria-live="polite"></div></form></div></div></section>
</MainLayout>
